    "%@ est installé : Void le laisse enregistrer et remplir vos mots de passe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is installed: Void lets it save and fill your passwords."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est installé : Void le laisse enregistrer et remplir vos mots de passe."
          }
        }
      }
    },
    "%@ est installé sur ce Mac, mais sans son extension il ne remplit rien dans Void : Void continue d'enregistrer et de remplir vos mots de passe. Ajoutez son extension pour lui laisser la main." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is installed on this Mac, but without its extension it fills nothing in Void: Void keeps saving and filling your passwords. Add its extension to hand over to it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est installé sur ce Mac, mais sans son extension il ne remplit rien dans Void : Void continue d'enregistrer et de remplir vos mots de passe. Ajoutez son extension pour lui laisser la main."
          }
        }
      }
    },
