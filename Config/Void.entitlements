<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Void is NOT sandboxed (like Safari's host app, Chrome and Firefox): importing
	from other browsers requires reading their profile folders and their
	"Safe Storage" keychain items. Hardened Runtime stays on.
	-->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Websites asking for the position (navigator.geolocation): Hardened Runtime blocks Location Services without it. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
